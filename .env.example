# Copy this to .env and fill in as needed. Never commit .env — it's gitignored for a reason.

# ollama | deepinfra | anthropic | openai
# Stick with ollama on a work laptop — it's the only one where file contents
# never leave the machine. Switching to a cloud provider is on you.
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# only read when LLM_PROVIDER=deepinfra — sends document text to DeepInfra's API (Section 17.4)
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# only read when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# only read when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# embeddings are always local regardless of the provider above
EMBEDDING_MODEL=all-MiniLM-L6-v2

# JSON array of folders to watch and index
WATCHED_DIRS=["~/Downloads", "~/Desktop", "~/Documents"]
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
LANCEDB_PATH=./data/index

# pynput format — if this clashes with your IDE, try <alt>+<space> or <ctrl>+<shift>+/
HOTKEY=<ctrl>+<space>

# the server only ever binds to 127.0.0.1, this just picks the port
API_PORT=8765
