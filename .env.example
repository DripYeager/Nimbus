# Developer configuration. Everyday users never need this file: the Settings window saves
# their choices to %APPDATA%\Nimbus\settings.json, and those take priority over anything here.
# Copy to .env to use. Never commit .env.

# ollama | openai | anthropic | openai_compatible
# ollama is the only option where file contents never leave the machine.
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# Any server that speaks the OpenAI chat API: DeepInfra, Groq, LM Studio, vLLM...
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=

# Fallback keys for development. Keys entered in Settings go to Windows Credential Manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPATIBLE_API_KEY=

# Local ONNX embedding model (downloaded once on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# JSON list of folders; include_contents=false makes a folder searchable by name only
SOURCES=[{"path": "~/Documents"}, {"path": "~/Downloads"}, {"path": "~/Desktop"}]
MAX_FILE_SIZE_MB=50
EXCLUDE_PATTERNS=["*.iso", "Archive"]

# Where the index, catalog, chats and notes live (defaults to %APPDATA%\Nimbus)
# DATA_DIR=~/nimbus-data

# If this clashes with another app, try <alt>+<space> or <ctrl>+<shift>+n
HOTKEY=<ctrl>+<space>

# Optional daily cap on model calls (leave unset for no limit)
# DAILY_LLM_CALL_CAP=200

# The server only ever binds to 127.0.0.1; this just picks the port
API_PORT=8765
